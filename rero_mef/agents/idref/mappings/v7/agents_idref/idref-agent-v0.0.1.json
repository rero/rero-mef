{
  "settings": {
    "number_of_shards": 8,
    "number_of_replicas": 2,
    "max_result_window": 100000000,
    "analysis": {
      "filter": {
        "french_elision": {
          "type": "elision",
          "articles_case": true,
          "articles": [
            "l",
            "m",
            "t",
            "qu",
            "n",
            "s",
            "j",
            "d",
            "c",
            "jusqu",
            "quoiqu",
            "lorsqu",
            "puisqu"
          ]
        },
        "my_ascii_folding": {
          "type": "asciifolding",
          "preserve_original": true
        }
      },
      "analyzer": {
        "french_access_point": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "french_elision",
            "lowercase",
            "my_ascii_folding"
          ]
        }
      }
    }
  },
  "mappings": {
    "date_detection": false,
    "numeric_detection": false,
    "properties": {
      "$schema": {
        "type": "keyword"
      },
      "pid": {
        "type": "keyword"
      },
      "type": {
        "type": "keyword"
      },
      "md5": {
        "type": "keyword"
      },
      "language": {
        "type": "keyword"
      },
      "gender": {
        "type": "keyword"
      },
      "identifiedBy": {
        "type": "object",
        "properties": {
          "type": {
            "type": "keyword"
          },
          "source": {
            "type": "keyword"
          },
          "value": {
            "type": "keyword"
          },
          "_identifier": {
            "type": "keyword"
          }
        }
      },
      "date_of_birth": {
        "type": "text"
      },
      "date_of_death": {
        "type": "text"
      },
      "biographical_information": {
        "type": "text"
      },
      "preferred_name": {
        "type": "text"
      },
      "authorized_access_point": {
        "type": "text",
        "analyzer": "french_access_point",
        "fields": {
          "raw": {
            "type": "keyword"
          }
        }
      },
      "qualifier": {
        "type": "keyword"
      },
      "numeration": {
        "type": "keyword"
      },
      "variant_name": {
        "type": "text",
        "analyzer": "french_access_point",
        "fields": {
          "raw": {
            "type": "keyword"
          }
        }
      },
      "date_of_establishment": {
        "type": "text"
      },
      "date_of_termination": {
        "type": "text"
      },
      "conference": {
        "type": "keyword"
      },
      "variant_access_point": {
        "type": "text",
        "analyzer": "french_access_point",
        "fields": {
          "raw": {
            "type": "keyword"
          }
        }
      },
      "parallel_access_point": {
        "type": "text",
        "analyzer": "french_access_point",
        "fields": {
          "raw": {
            "type": "keyword"
          }
        }
      },
      "country_associated": {
        "type": "keyword"
      },
      "deleted": {
        "type": "date"
      },
      "relation_pid": {
        "type": "object",
        "properties": {
          "value": {
            "type": "keyword"
          },
          "type": {
            "type": "keyword"
          }
        }
      },
      "_created": {
        "type": "date"
      },
      "_updated": {
        "type": "date"
      }
    }
  }
}
