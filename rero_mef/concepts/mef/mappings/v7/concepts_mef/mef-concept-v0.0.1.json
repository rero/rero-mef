{
  "settings": {
    "number_of_shards": 8,
    "number_of_replicas": 2,
    "max_result_window": 100000000,
    "analysis": {
      "filter": {
        "french_elision": {
          "type": "elision",
          "articles_case": true,
          "articles": [
            "l",
            "m",
            "t",
            "qu",
            "n",
            "s",
            "j",
            "d",
            "c",
            "jusqu",
            "quoiqu",
            "lorsqu",
            "puisqu"
          ]
        },
        "german_decompounder": {
          "type": "hyphenation_decompounder",
          "word_list_path": "analysis/dictionary-de.txt",
          "hyphenation_patterns_path": "analysis/de_DR.xml",
          "only_longest_match": true,
          "min_subword_size": 4
        },
        "my_ascii_folding": {
          "type": "asciifolding",
          "preserve_original": true
        },
        "autocomplete_filter": {
          "type": "edge_ngram",
          "min_gram": 1,
          "max_gram": 20
        }
      },
      "analyzer": {
        "french_access_point": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "french_elision",
            "lowercase",
            "my_ascii_folding"
          ]
        },
        "german_access_point": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "lowercase",
            "german_normalization",
            "german_decompounder",
            "my_ascii_folding"
          ]
        },
        "autocomplete": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "french_elision",
            "lowercase",
            "german_normalization",
            "german_decompounder",
            "autocomplete_filter",
            "my_ascii_folding"
          ]
        },
        "autocomplete_search": {
          "type": "custom",
          "tokenizer": "standard",
          "filter": [
            "french_elision",
            "lowercase",
            "german_normalization",
            "german_decompounder",
            "my_ascii_folding"
          ]
        }
      }
    }
  },
