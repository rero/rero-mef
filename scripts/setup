#!/usr/bin/env bash
# SPDX-FileCopyrightText: Fondation RERO+
# SPDX-License-Identifier: AGPL-3.0-or-later

PROGRAM=$(basename "$0")

# Colored message helpers: msg, info_msg, error_msg, error_msg+exit,
# success_msg, colored_msg.
. "$(dirname "${BASH_SOURCE[0]}")/messages"

# The `batch_*` functions emitting the command lines of each batch.
. "$(dirname "${BASH_SOURCE[0]}")/setup_batches"

# Where the fixtures and the OAI sources are read from.
DATA_PATH=./data

set -e

# uv is a mandatory condition to launch this program!
if [[ -z "${VIRTUAL_ENV}" ]]; then
  error_msg+exit "Error - Launch this script via uv command:\n\tuv run ${PROGRAM}"
fi

# Reset the database and the search indices, then create the accounts.
#
# The three commands before the batch cannot join it: `celery purge` is not an
# invenio command, and the other two have to be tolerated on a first run, when
# there is nothing to flush and no database to destroy. `db destroy` also
# issues a DROP DATABASE, which fails as soon as anything in the same process
# has opened a connection to that database.
function db_init () {
    info_msg "DB init"
    # Purge celery
    celery -A rero_mef.celery purge -f
    # Clean redis
    invenio utils flush-cache --yes-i-know || true
    invenio db destroy --yes-i-know || true
    invenio db init create
    invenio index destroy --force --yes-i-know || true

    info_msg "Search indices, indexing queue, roles, users and token"
    invenio rero batch <(batch_index_init; batch_accounts)
}

function oai_init () {
    info_msg "OAI init"
    invenio rero batch <(batch_oai)
}

function sample_load () {
    info_msg "Importing VIAF, agent, concept and place records, then OAI init"
    invenio rero batch <(batch_sample_load; batch_oai)
}

function deploy () {
    INPUT_DIR=$1
    info_msg "Start loading CSV records to database: ${INPUT_DIR}"
    invenio rero batch <(batch_load_csv "${INPUT_DIR}"; batch_oai; batch_index_run)
    # invenio utils reindex-missing -v
}

# The only step that is deliberately not a batch: one process per entity, run
# in parallel.
function create_json () {
    INPUT_DIR=$1
    OUTPUT_DIR=$2
    info_msg "Start creating json: ${INPUT_DIR} ${OUTPUT_DIR}"
    # Transform MARC files to json
    for ENTITY in "${MARC_ENTITIES[@]}"
    do
        invenio fixtures marc-to-json ${ENTITY} ${INPUT_DIR}/${ENTITY}.mrc ${OUTPUT_DIR}/${ENTITY}.json --error_file ${OUTPUT_DIR}/${ENTITY}_error.mrc &
    done
    trap 'jobs -p | xargs kill' EXIT
    wait
}

function create_csv () {
    OUTPUT_DIR=$1
    info_msg "Start creating csv, then the VIAF and MEF ones: ${OUTPUT_DIR}"
    invenio rero batch <(batch_create_csv "${OUTPUT_DIR}")
}

function create_and_load () {
    INPUT_DIR=$1
    OUTPUT_DIR=$2
    # Transform MARC files to json
    create_json ${INPUT_DIR} ${OUTPUT_DIR}

    # Create CSV files from json
    create_csv ${OUTPUT_DIR}

    db_init
    # Load CSV files to db
    deploy ${OUTPUT_DIR}
}

function viaf_init () {
    INPUT_DIR=$1
    info_msg "Start loading from VIAF file: ${INPUT_DIR}"
    db_init
    invenio rero batch <(batch_oai; batch_viaf_init "${INPUT_DIR}")
}

function usage () {
    msg "Usage: "
    msg " [./scripts/setup]"
    msg "    Load prepared JSON files available in git/data"
    msg " "
    msg " [./scripts/setup --db_init]"
    msg " "
    msg " [./scripts/setup --deploy INPUT_DIR]"
    msg "    INPUT_DIR where CSV files are found. "
    msg " "
    msg " [./scripts/setup --create_and_load INPUT_DIR OUTPUT_DIR]"
    msg "    INPUT_DIR where MARC files are found. "
    msg "    OUTPUT_DIR directory for output file"
    msg " "
    msg " [./scripts/setup --create_json INPUT_DIR OUTPUT_DIR]"
    msg "    INPUT_DIR where MARC files are found. "
    msg "    OUTPUT_DIR directory for output file"
    msg " "
    msg " [./scripts/setup --create_csv INPUT_OUTPUT_DIR]"
    msg "    INPUT_OUTPUT_DIR directory for input and output file"
    msg " "
    msg " [./scripts/setup --viaf_init INPUT_DIR]"
    msg "    INPUT_DIR directory for VIAF CSV files"

}

if [[ $# -eq 0 ]] ; then
    info_msg "Start sample loading of all types of entities"
    db_init
    sample_load
else
    case $1 in
        '--db_init')
            db_init
            ;;
        '--oai_init')
            oai_init
            ;;
        '--deploy')
            if [ -z "$2" ]; then
                error_msg "Invalid input arguments. "
                usage
                exit 1
            else
                db_init
                deploy $2
            fi
            ;;
        '--create_and_load')
            if [ -z "$2" ] || [ -z "$3" ]; then
                error_msg "Invalid input arguments. "
                usage
                exit 3
            else
                create_and_load $2 $3
            fi
            ;;
        '--create_json')
            if [ -z "$2" ] || [ -z "$3" ]; then
                error_msg "Invalid input arguments. "
                usage
                exit 3
            else
                create_json $2 $3
            fi
            ;;
        '--create_csv')
            if [ -z "$2" ]; then
                error_msg "Invalid input arguments. "
                usage
                exit 3
            else
                create_csv $2
            fi
            ;;
        '--viaf_init')
            if [ -z "$2" ]; then
                error_msg "Invalid input arguments. "
                usage
                exit 3
            else
                viaf_init $2
            fi
            ;;
        '--help')
                usage
            ;;
        *)
            error_msg "Invalid input arguments. "
            usage
            exit 4
            ;;
    esac
fi

success_msg "${PROGRAM} finished"
exit 0
