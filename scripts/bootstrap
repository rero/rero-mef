#!/usr/bin/env bash
# SPDX-FileCopyrightText: Fondation RERO+
# SPDX-License-Identifier: AGPL-3.0-or-later

PROGRAM=`basename $0`

set -e

# Colored message helpers: msg, info_msg, error_msg, error_msg+exit,
# success_msg, colored_msg.
. "$(dirname "${BASH_SOURCE[0]}")/messages"

# Displays program name
msg "PROGRAM: ${PROGRAM}"

# The result is not consumed, but getopt rejects an unknown option for us. Its
# lists have to name every option the loop below accepts, `force-certs`
# included, or the call fails on the very options this script supports.
if ! options=$(getopt -o dc -l deploy,ci,force-certs -- "$@")
then
    # something went wrong, getopt will put out an error message for us
    exit 1
fi

# The real bootstrap script starts 20 lines below ;-)
flags=()
deploy=false
cmd="uv sync --frozen"
ci=false
force_certs=false
while test $# -gt 0
do
    case "$1" in
      -d|--deploy)
        # We are probably inside travis, check for env variables
        deploy=true ;;
      -c|--ci)
        # We are probably inside travis, check for env variables
        ci=true ;;
      --force-certs)
        force_certs=true ;;
      (--) shift; break;;
      (-*) flags+=("$1") ;;
      (*) break;;
    esac
    shift
done

# uv is a mandatory condition to launch this program!
if [[ -z "${VIRTUAL_ENV}" ]]; then
  error_msg+exit "Error - Launch this script via uv command:\n\tuv run ${PROGRAM}"
fi

if $deploy ; then
  if ! $ci ; then
      flags=( "--no-group dev --group prod" )
  fi
else
    if $ci ; then
        cmd="uv sync --upgrade"
    fi
fi

# BOOTSTRAP START
# install the application and all the dependencies
flag="${flags[@]}"
info_msg "Install with command: ${cmd} ${flag}"
${cmd} ${flags[@]}

# build the web assets
info_msg "Build web assets: collect"
invenio collect -v

info_msg "Build web assets: using webpack for invenio-admin"
invenio webpack buildall

if ! $deploy ; then
  # The development server needs a TLS pair; a deployment brings its own.
  certs_flags=()
  if $force_certs ; then
    certs_flags+=("--force")
  fi
  "$(dirname "${BASH_SOURCE[0]}")"/gen-certs "${certs_flags[@]}"
fi

if $deploy ; then
  if ! $ci ; then
    info_msg "Clean web assets"
    invenio webpack clean

    info_msg "Clean npm cache"
    npm cache clean --force

    info_msg "Clean pip cache"
    pip cache purge
  fi
fi

success_msg "${PROGRAM} finished!"
exit 0
