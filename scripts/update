#!/usr/bin/env bash
# SPDX-FileCopyrightText: Fondation RERO+
# SPDX-License-Identifier: AGPL-3.0-or-later

PROGRAM=`basename $0`

set -e

# Colored message helpers: msg, info_msg, error_msg, error_msg+exit,
# success_msg, colored_msg.
. "$(dirname "${BASH_SOURCE[0]}")/messages"

# Displays program name
msg "PROGRAM: ${PROGRAM}"

# uv is a mandatory condition to launch this program!
if [[ -z "${VIRTUAL_ENV}" ]]; then
  error_msg+exit "Error - Launch this script via uv command:\n\tuv run ${PROGRAM}"
fi

script_path=$(dirname "$0")
./"$script_path"/bootstrap

uv run invenio  index create --verbose concepts_idref-idref-concept-v0.0.1 -b rero_mef/concepts/idref/mappings/v7/concepts_idref/idref-concept-v0.0.1.json
invenio utils update_mapping
invenio alembic upgrade

invenio oaiharvester initconfig ./data/oaisources.yml
invenio oaiharvester set-last-run -n agents.gnd -d 2022-08-01
invenio oaiharvester set-last-run -n agents.idref -d 2022-08-01
invenio oaiharvester set-last-run -n concepts.idref -d 1990-01-01
